# Umami Analytics Configuration
# 获取这些值的步骤：
# 1. 注册 Umami Cloud 账号：https://cloud.umami.is
# 2. 或自托管 Umami：https://umami.is/docs/install
# 3. 创建网站并获取 Website ID

# Umami Website ID（必填）
PUBLIC_UMAMI_WEBSITE_ID=YOUR_WEBSITE_ID

# Umami Script URL（可选，默认使用 Umami Cloud）
# 如果自托管，修改为：https://your-umami-domain.com/script.js
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
