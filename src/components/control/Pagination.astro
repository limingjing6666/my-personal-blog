---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<div class:list={[className, "flex flex-row gap-2 justify-center"]} style={style}>
    <a href={page.url.prev || ""} aria-label={page.url.prev ? "Previous Page" : null}
       class:list={["flex items-center justify-center rounded-xl text-[var(--primary)] w-10 h-10 transition-all hover:bg-[var(--btn-regular-bg)] active:scale-90",
           {"pointer-events-none text-black/10 dark:text-white/10": page.url.prev == undefined}
       ]}
    >
        <Icon name="material-symbols:chevron-left-rounded" class="text-[1.5rem]"></Icon>
    </a>
    <div class="bg-[var(--card-bg)] flex flex-row rounded-xl items-center text-75 font-medium text-sm border border-black/[0.04] dark:border-white/[0.06]">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <Icon name="material-symbols:more-horiz" class="mx-1 text-30"/>;
            if (p == page.currentPage)
                return <div class="h-10 w-10 rounded-xl bg-[var(--primary)] flex items-center justify-center
                    font-bold text-white dark:text-black/70"
                >
                    {p}
                </div>
            return <a href={url(getPageUrl(p))} aria-label={`Page ${p}`}
                class="flex items-center justify-center w-10 h-10 rounded-xl overflow-hidden active:scale-90 transition-all hover:bg-[var(--btn-regular-bg)]"
            >{p}</a>
        })}
    </div>
    <a href={page.url.next || ""} aria-label={page.url.next ? "Next Page" : null}
       class:list={["flex items-center justify-center rounded-xl text-[var(--primary)] w-10 h-10 transition-all hover:bg-[var(--btn-regular-bg)] active:scale-90",
           {"pointer-events-none text-black/10 dark:text-white/10": page.url.next == undefined}
       ]}
    >
        <Icon name="material-symbols:chevron-right-rounded" class="text-[1.5rem]"></Icon>
    </a>
</div>
