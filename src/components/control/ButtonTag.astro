---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label}
   class="inline-flex items-center h-7 text-xs px-2.5 rounded-lg transition-all
   text-50 hover:text-[var(--primary)] bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)]">
    {dot && <div class="h-1 w-1 bg-current transition rounded-full mr-1.5 opacity-50"></div>}
    <slot></slot>
</a>
