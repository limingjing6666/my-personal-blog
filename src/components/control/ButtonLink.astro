---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label}>
    <button
        class:list={`
            w-full
            h-9
            rounded-xl
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            pl-2
            hover:pl-3

            text-75
            hover:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between relative mr-2">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis text-sm">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition px-2 h-6 ml-3 min-w-[1.5rem] rounded-lg text-xs font-bold
                    text-[var(--btn-content)]
                    bg-[var(--btn-regular-bg)]
                    flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
