---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<div class="transition my-12 flex flex-col items-center justify-center px-6">
    <div class="flex items-center gap-3 mb-4 opacity-30">
        <div class="h-px w-12 bg-current"></div>
        <div class="w-1 h-1 rounded-full bg-current"></div>
        <div class="h-px w-12 bg-current"></div>
    </div>
    <div class="transition text-30 text-xs text-center font-medium tracking-wide">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}
    </div>
</div>
