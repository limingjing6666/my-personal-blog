---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-5 overflow-hidden">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mb-4
       max-w-[10rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95 transition-transform">
        <div class="absolute transition pointer-events-none group-hover:bg-black/20 group-active:bg-black/30
        w-full h-full z-50 flex items-center justify-center rounded-xl">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-4xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full aspect-square object-cover rounded-xl"></ImageWrapper>
    </a>
    <div class="text-center">
        <div class="font-serif font-bold text-xl text-90 mb-1 transition">{config.name}</div>
        <div class="h-0.5 w-8 bg-[var(--primary)] mx-auto rounded-full mb-2.5 transition opacity-60"></div>
        <div class="text-sm text-50 mb-4 transition leading-relaxed">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                       class="flex items-center justify-center rounded-xl h-9 w-9 active:scale-90 transition-all text-50 hover:text-[var(--primary)] hover:bg-[var(--btn-regular-bg)]">
                        <Icon name={item.icon} class="text-[1.25rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="flex items-center justify-center rounded-xl h-9 gap-2 px-3 font-medium text-sm active:scale-95 transition-all text-50 hover:text-[var(--primary)] hover:bg-[var(--btn-regular-bg)]">
                <Icon name={config.links[0].icon} class="text-[1.1rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>
