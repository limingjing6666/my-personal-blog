---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div id="view-counter" class="flex items-center text-black/30 dark:text-white/30 text-sm">
  <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
      <path fill="currentColor" d="M12 9a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3m0 8a5 5 0 0 1-5-5a5 5 0 0 1 5-5a5 5 0 0 1 5 5a5 5 0 0 1-5 5m0-12.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5"/>
    </svg>
  </div>
  <span id="view-count">--</span>
  <span class="ml-1">次浏览</span>
</div>

<script define:vars={{ title }}>
  // 浏览量统计
  const storageKey = `blog_views_${title}`;
  
  // 获取当前浏览量
  let views = parseInt(localStorage.getItem(storageKey) || '0');
  
  // 增加浏览量
  views += 1;
  localStorage.setItem(storageKey, views.toString());
  
  // 显示浏览量
  const viewCountElement = document.getElementById('view-count');
  if (viewCountElement) {
    viewCountElement.textContent = views.toString();
  }
</script>
