---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "30%";

const { remarkPluginFrontmatter } = await entry.render();
---
<a href={url} class:list={["card-base group block w-full rounded-[var(--radius-large)] overflow-hidden relative transition-all duration-300 hover:translate-y-[-2px]", className]} style={style}>
    <div class:list={["flex flex-col", hasCover ? "md:flex-row" : ""]}>
        <!-- Content -->
        <div class:list={["flex-1 p-6 md:p-8", hasCover ? "md:max-w-[70%]" : ""]}>
            <!-- Category tag -->
            {category && <div class="inline-flex items-center gap-1.5 mb-3 text-xs font-medium tracking-wide uppercase text-[var(--primary)] opacity-70">
                <span class="w-1 h-1 rounded-full bg-[var(--primary)]"></span>
                {category}
            </div>}

            <!-- Title -->
            <h2 class="font-serif text-xl md:text-2xl font-bold text-90 mb-2.5 leading-snug group-hover:text-[var(--primary)] transition-colors duration-300">
                {title}
            </h2>

            <!-- Description -->
            <p class:list={["text-50 text-sm leading-relaxed mb-4", {"line-clamp-2": !description}]}>
                { description || remarkPluginFrontmatter.excerpt }
            </p>

            <!-- Metadata row -->
            <div class="flex items-center gap-4 text-xs text-30">
                <span class="flex items-center gap-1.5">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm opacity-60"></Icon>
                    {new Date(published).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}
                </span>
                <span class="w-0.5 h-0.5 rounded-full bg-25"></span>
                <span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
                {tags && tags.length > 0 && <>
                    <span class="w-0.5 h-0.5 rounded-full bg-25"></span>
                    <span class="flex items-center gap-1.5">
                        {tags.slice(0, 2).map((tag, i) => (
                            <span class="px-1.5 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-50">{tag.trim()}</span>
                        ))}
                    </span>
                </>}
            </div>
        </div>

        <!-- Cover image -->
        {hasCover && <div class="relative overflow-hidden md:w-[30%] min-h-[12rem] md:min-h-0">
            <div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent z-10 pointer-events-none"></div>
            <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
            </ImageWrapper>
        </div>}
    </div>
</a>
