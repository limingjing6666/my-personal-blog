---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;
---

<div class:list={["flex flex-wrap text-50 items-center gap-3 text-xs", className]}>
    <!-- publish date -->
    <div class="flex items-center gap-1.5">
        <Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm opacity-50"></Icon>
        <span class="font-medium">{formatDateToYYYYMMDD(published)}</span>
    </div>

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center gap-1.5">
            <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-sm opacity-50"></Icon>
            <span class="font-medium">{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}

    <!-- categories -->
    <div class="flex items-center gap-1.5">
        <Icon name="material-symbols:book-2-outline-rounded" class="text-sm opacity-50"></Icon>
        <a href={getCategoryUrl(category)} aria-label={`View all posts in the ${category} category`}
           class="font-medium hover:text-[var(--primary)] transition-colors whitespace-nowrap">
            {category || i18n(I18nKey.uncategorized)}
        </a>
    </div>

    <!-- tags -->
    <div class:list={["items-center gap-1.5", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
        <Icon name="material-symbols:tag-rounded" class="text-sm opacity-50"></Icon>
        <div class="flex flex-row flex-nowrap items-center gap-1">
            {(tags && tags.length > 0) && tags.map((tag) => (
                <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
                   class="font-medium hover:text-[var(--primary)] transition-colors whitespace-nowrap
                   px-1.5 py-0.5 rounded-md bg-[var(--btn-regular-bg)]">
                    {tag.trim()}
                </a>
            ))}
            {!(tags && tags.length > 0) && <div class="transition font-medium">{i18n(I18nKey.noTags)}</div>}
        </div>
    </div>
</div>
