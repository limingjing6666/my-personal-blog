/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0.75rem
  --radius-small 0.5rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.55 0.16 var(--hue)) oklch(0.72 0.14 var(--hue))
  --page-bg: oklch(0.97 0.005 85) oklch(0.17 0.012 260)
  --card-bg: oklch(0.99 0.003 85) oklch(0.22 0.012 260)

  --btn-content: oklch(0.50 0.14 var(--hue)) oklch(0.72 0.10 var(--hue))

  --btn-regular-bg: oklch(0.94 0.012 85) oklch(0.30 0.025 260)
  --btn-regular-bg-hover: oklch(0.90 0.03 var(--hue)) oklch(0.35 0.03 var(--hue))
  --btn-regular-bg-active: oklch(0.86 0.05 var(--hue)) oklch(0.40 0.035 var(--hue))

  --btn-plain-bg-hover: oklch(0.94 0.015 var(--hue)) oklch(0.28 0.025 260)
  --btn-plain-bg-active: oklch(0.97 0.008 85) oklch(0.25 0.02 260)

  --btn-card-bg-hover: oklch(0.97 0.005 85) oklch(0.27 0.02 260)
  --btn-card-bg-active: oklch(0.93 0.015 85) oklch(0.32 0.025 260)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.03 85)

  --title-active: oklch(0.50 0.12 var(--hue))

  --line-divider: black(0.06) white(0.06)

  --line-color: black(0.08) white(0.08)
  --meta-divider: black(0.15) white(0.15)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.92 0.04 var(--hue)) oklch(0.35 0.06 var(--hue))
  --codeblock-selection: oklch(0.35 0.06 var(--hue))
  --codeblock-bg: oklch(0.18 0.012 260) oklch(0.18 0.012 260)
  --codeblock-topbar-bg: oklch(0.28 0.015 260) oklch(0.14 0.01 260)

  --license-block-bg: black(0.025) var(--codeblock-bg)

  --link-underline: oklch(0.90 0.03 var(--hue)) oklch(0.35 0.06 var(--hue))
  --link-hover: oklch(0.93 0.02 var(--hue)) oklch(0.35 0.06 var(--hue))
  --link-active: oklch(0.88 0.04 var(--hue)) oklch(0.30 0.05 var(--hue))

  --float-panel-bg: oklch(0.99 0.003 85) oklch(0.20 0.012 260)

  --scrollbar-bg-light: black(0.25)
  --scrollbar-bg-hover-light: black(0.35)
  --scrollbar-bg-active-light: black(0.45)

  --scrollbar-bg-dark: white(0.3)
  --scrollbar-bg-hover-dark: white(0.4)
  --scrollbar-bg-active-dark: white(0.5)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.65 0.12 165) oklch(0.72 0.12 165)
  --admonitions-color-note: oklch(0.60 0.12 250) oklch(0.68 0.12 250)
  --admonitions-color-important: oklch(0.62 0.14 320) oklch(0.70 0.14 320)
  --admonitions-color-warning: oklch(0.72 0.12 85) oklch(0.75 0.12 85)
  --admonitions-color-caution: oklch(0.58 0.18 30) oklch(0.65 0.18 30)

  --toc-badge-bg: oklch(0.92 0.03 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.95 0.01 85) oklch(0.24 0.015 260)
  --toc-btn-active: oklch(0.93 0.01 85) oklch(0.27 0.015 260)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.55 0.12 var(--hue)) oklch(0.40 0.06 var(--hue))

  --nav-shadow: unquote("0 1px 3px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.03), 0 1px 2px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.08)")
  --card-shadow: unquote("0 1px 3px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.02), 0 1px 3px rgba(0,0,0,0.06), 0 2px 10px rgba(0,0,0,0.04)")
  --card-shadow-hover: unquote("0 2px 6px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.04), 0 2px 4px rgba(0,0,0,0.08), 0 8px 28px rgba(0,0,0,0.06)")
})
